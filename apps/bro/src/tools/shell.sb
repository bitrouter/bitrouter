(version 1)
(deny default)
(import "/System/Library/Sandbox/Profiles/dyld-support.sb")
(allow process-fork)
(allow signal (target same-sandbox))
(allow file-read-data file-read-metadata file-map-executable process-exec
    (subpath (param "BRO_WORKSPACE"))
    (subpath "/bin") (subpath "/usr/bin") (subpath "/usr/lib")
    (subpath "/System/Library"))
(allow file-read-metadata (literal "/") (literal "/usr") (literal "/System"))
(allow file-read-data file-read-metadata (literal "/dev/zero") (literal "/dev/urandom"))
(allow file-read* file-write-data (literal "/dev/null"))
(allow file-write* (subpath (param "BRO_WORKSPACE")))
(deny syscall-unix (syscall-number SYS_setsid SYS_setpgid))
