{
  "id": "acp-continuation-green3",
  "scope": "Controlled real SQLite pre-prompt image after actual source process/owner shutdown and Rust peer private nonce restore. Five cases: same session, live owner, missing private data, unsupported load, paused source. No submitted prompt replay or arbitrary crash takeover claim.",
  "jobs": [
    {
      "name": "same-session",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "-E",
        "test(acp_pre_prompt_recovery_loads_only_the_original_stopped_session)",
        "--success-output",
        "final"
      ]
    },
    {
      "name": "acp-guards",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter-orchestrator",
        "--all-features",
        "--lib",
        "-E",
        "test(service::tests::worker::acp::) | test(lost_restore_start_ack)"
      ]
    },
    {
      "name": "stopped-history",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "-E",
        "test(stopped_history_is_hash_bound)"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    }
  ]
}
