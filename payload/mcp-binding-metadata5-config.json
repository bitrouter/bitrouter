{
  "id": "mcp-binding-metadata5",
  "scope": "Frozen selected MCP configuration at missing Thread and at existing ACP metadata without a Turn; immutable accepted native/ACP receipts remain readable after config edits",
  "jobs": [
    {
      "name": "boundaries",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "--no-fail-fast",
        "-E",
        "test(goal_runtime::tests::threads) | test(goal_runtime::tests::start_recovery)"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ]
    },
    {
      "name": "goal-runtime",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "--no-fail-fast",
        "-E",
        "test(goal_runtime)"
      ]
    }
  ]
}
