{
  "id": "dispatch-rejection-green9",
  "scope": "Post-completion-fix qualification: all Goal domain tests, all Goal runtime fixtures, strict workspace lint/format and workspace doctests. Earlier full nextest belongs to source green6",
  "jobs": [
    {
      "name": "goal-domain",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--test",
        "goals"
      ]
    },
    {
      "name": "goal-runtime",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "-E",
        "test(goal_runtime::)"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    },
    {
      "name": "rustdoc",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--doc"
      ]
    }
  ]
}
