{
  "id": "token-wait-final3",
  "scope": "Frozen native reservation-wait source: current-worker settlement/pause/lost ACK, unknown-cost holds, immutable route/quote replay, SDK no-dispatch cancellation, read-only projection, writer fencing and full workspace regressions. This is a local gate for this batch, not completion of S0-S6/live/CI gates.",
  "jobs": [
    {
      "name": "boundaries",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "-E",
        "test(worker_accounting_survives_an_independent_edit_but_rejects_its_own_stale_scope) | test(frozen_plan_replay_preserves_quotes_and_undispatched_admission_settles_once) | test(quote_wait_projection_is_current_source_scoped_and_distinct_from_budget_exhaustion) | test(undispatched_admission_and_resource_wait_never_claim_a_serving_model) | test(legacy_startup_rejects_managed_goal_format_without_rewriting_old_goals)"
      ]
    },
    {
      "name": "workspace",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--no-fail-fast"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    },
    {
      "name": "rustdoc",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--doc"
      ]
    }
  ]
}
