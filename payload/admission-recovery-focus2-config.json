{
  "id": "admission-recovery-focus2",
  "scope": "Current ACP saved-intent recovery with original legacy supervisor priority; partial A16, not same-session/active recovery closure",
  "jobs": [
    {
      "name": "interruptions",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "--no-fail-fast",
        "-E",
        "test(goal_runtime::tests::threads) | test(goal_runtime::tests::start_recovery)"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ]
    },
    {
      "name": "goal-runtime",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "--no-fail-fast",
        "-E",
        "test(goal_runtime)"
      ]
    },
    {
      "name": "stress",
      "args": [
        "nextest",
        "run",
        "-p",
        "bitrouter",
        "--all-features",
        "--lib",
        "--no-fail-fast",
        "--stress-count",
        "5",
        "-E",
        "test(saved_acp_intent_without_any_thread) | test(paused_goal_recovers_original_start)"
      ]
    }
  ]
}
