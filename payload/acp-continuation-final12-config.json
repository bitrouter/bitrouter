    {
      "name": "typed-startup",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--lib",
        "-E",
        "test(goal_runtime::resources::tests::unsupported_mcp_transports_) | test(goal_runtime::resources::tests::unconfirmed_model_route_)"
      ]
    },
    {
      "name": "workspace",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--no-fail-fast"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    },
    {
      "name": "doctest",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--doc"
      ]
    },
    {
      "name": "registry",
      "args": [
        "run",
        "-p",
        "dist-helper",
        "--",
        "check"
      ]
    }
  ]
