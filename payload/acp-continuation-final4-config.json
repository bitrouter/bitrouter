{
  "id": "acp-continuation-final4",
  "scope": "Whole workspace verification after controlled ACP original-session recovery, unknown-start guard and ownership-bound stopped history. Local fixture evidence; actual vendor/provider gate remains unpassed.",
  "jobs": [
    {
      "name": "workspace",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--no-fail-fast"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    },
    {
      "name": "doctest",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--doc"
      ]
    },
    {
      "name": "registry",
      "args": [
        "run",
        "-p",
        "dist-helper",
        "--",
        "check"
      ]
    }
  ]
}
