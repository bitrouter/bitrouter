+    };
+    tokio::time::timeout(Duration::from_secs(3), visits.recv())
+        .await?
+        .ok_or("the entrypoint source check was not reached")?;
+    control.budget.revoked.store(true, Ordering::SeqCst);
+    drop(admission);
