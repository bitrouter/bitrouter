{
  "id": "unix-tty-focused88",
  "scope": "Only apps/bitrouter/Cargo.toml changes: extend the already-qualified macOS pollfd/libc event-source configuration to cfg(unix), including Linux epoll. All production Rust and test files match full local77; macOS all-feature dependency feature trees before/after are byte-identical. This focused run is not a fresh full4757 run; original full77 remains separately bound. Actual Linux proof must come from the next exact-head native-goals shard/full CI.",
  "jobs": [
    {
      "name": "native-features",
      "args": [
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features"
      ]
    },
    {
      "name": "acp-features",
      "args": [
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features",
        "--features",
        "acp"
      ]
    },
    {
      "name": "native-tree",
      "args": [
        "tree",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features",
        "-e",
        "normal,build",
        "--prefix",
        "none"
      ]
    },
    {
      "name": "msrv-native",
      "args": [
        "+1.93",
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features"
      ]
    },
    {
      "name": "goal-pty",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "-E",
        "binary(goal_tui_pty)",
        "--test-threads",
        "2"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    },
    {
      "name": "doctest",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--doc"
      ]
    },
    {
      "name": "registry",
      "args": [
        "run",
        "-p",
        "dist-helper",
        "--",
        "check"
      ]
    }
  ]
}
