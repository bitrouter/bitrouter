{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed InferenceRoutingConfig (not accepted by current Config)",
  "description": "Design contract for the future Config.inference_routing field. This schema validates that field only; it is not the current application schema. Defaults are annotations, applied by the future Rust DTO.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "policy": {
      "enum": [
        "load_aware",
        "prefix_affinity"
      ],
      "default": "load_aware"
    },
    "queue": {
      "$ref": "#/$defs/queue"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "prefix": {
      "$ref": "#/$defs/prefix"
    },
    "destinations": {
      "type": "array",
      "maxItems": 4096,
      "default": [],
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "tenant_weights": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "default": {}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "destinations"
        ],
        "properties": {
          "destinations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 1024
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 67108864
        },
        "per_tenant_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 128
        },
        "per_tenant_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 8388608
        },
        "wait_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 2000
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 120000
        }
      },
      "default": {}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 128
        },
        "max_uncertain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 128
        },
        "uncertainty_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 120000
        },
        "max_state_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 4096
        },
        "max_state_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 33554432
        }
      },
      "default": {}
    },
    "prefix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 65536
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 16777216
        },
        "max_projection_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576,
          "default": 32768
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 120000
        }
      },
      "default": {}
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "model",
        "endpoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 8
        }
      }
    }
  }
}
