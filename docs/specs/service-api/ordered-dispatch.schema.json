{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordered dispatch contracts",
  "description": "Strict revision-bound selection, discovery and version-two execution facts. Semantic validation and live authorization remain required.",
  "$comment": "Wire objects reject duplicate fields during decoding; JSON Schema validates parsed values. Encoded document/header limits and cross-document invariants are enforced at runtime.",
  "oneOf": [
    {
      "$ref": "#/$defs/OrderedCandidateSelectionV1"
    },
    {
      "$ref": "#/$defs/CandidateManifestV1"
    },
    {
      "$ref": "#/$defs/OrderedCapabilitiesV2"
    },
    {
      "$ref": "#/$defs/OrderedDispatchBindingV2"
    },
    {
      "$ref": "#/$defs/ExecutionReceiptV2"
    },
    {
      "$ref": "#/$defs/ExecutionUsageEvidenceV2"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "AuthorityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Target": {
      "type": "object",
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/Id"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "account_id": {
          "$ref": "#/$defs/Id"
        },
        "credential_id": {
          "$ref": "#/$defs/Id"
        },
        "credential_version": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "provider_id",
        "model_id",
        "account_id",
        "credential_id",
        "credential_version"
      ],
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "enum": [
            "provider",
            "estimated",
            "unknown"
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens",
        "provenance",
        "complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "input_tokens": {
                "type": "null"
              },
              "output_tokens": {
                "type": "null"
              },
              "cache_read_tokens": {
                "type": "null"
              },
              "cache_write_tokens": {
                "type": "null"
              },
              "reasoning_tokens": {
                "type": "null"
              },
              "complete": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cache_read_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reasoning_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "estimated"
              }
            }
          },
          "then": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "NumericUsage": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_write_tokens",
            "reasoning_tokens"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "RouteRef": {
      "type": "object",
      "properties": {
        "owner_kind": {
          "enum": [
            "tenant",
            "operator_pool"
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_kind": {
          "type": "string",
          "const": "route"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "owner_kind",
        "owner_id",
        "resource_kind",
        "resource_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "CredentialRef": {
      "type": "object",
      "properties": {
        "owner_kind": {
          "enum": [
            "tenant",
            "operator_pool"
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_kind": {
          "type": "string",
          "const": "credential"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "owner_kind",
        "owner_id",
        "resource_kind",
        "resource_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "GenerationProtocol": {
      "type": "string",
      "enum": [
        "chat_completions",
        "messages",
        "responses",
        "generate_content"
      ]
    },
    "CandidateIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "OrderedCandidateSelectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "route",
        "candidate_indices",
        "admission_mode"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "route": {
          "$ref": "#/$defs/RouteRef"
        },
        "candidate_indices": {
          "$ref": "#/$defs/CandidateIndices"
        },
        "admission_mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "generation_defaults_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AcceptedSelectionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "inbound_protocol",
        "candidate_indices",
        "admission_mode"
      ],
      "properties": {
        "route": {
          "$ref": "#/$defs/RouteRef"
        },
        "inbound_protocol": {
          "$ref": "#/$defs/GenerationProtocol"
        },
        "candidate_indices": {
          "$ref": "#/$defs/CandidateIndices"
        },
        "admission_mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "generation_defaults_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CandidateDescriptorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_index",
        "target",
        "credential",
        "admission_profile"
      ],
      "properties": {
        "candidate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "credential": {
          "$ref": "#/$defs/CredentialRef"
        },
        "admission_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdmissionProfileRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CandidateManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "installation_id",
        "tenant_id",
        "execution_revision",
        "authority_revision",
        "route",
        "inbound_protocol",
        "candidates",
        "admission_mode",
        "runtime_observation"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "installation_id": {
          "$ref": "#/$defs/Id"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_revision": {
          "$ref": "#/$defs/Id"
        },
        "authority_revision": {
          "$ref": "#/$defs/AuthorityRevision"
        },
        "route": {
          "$ref": "#/$defs/RouteRef"
        },
        "inbound_protocol": {
          "$ref": "#/$defs/GenerationProtocol"
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CandidateDescriptorV1"
          }
        },
        "admission_mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "runtime_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeObservationV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$comment": "Maximum encoded size 1 MiB. Runtime validation enforces strictly increasing root ordinals, matching credential revisions and tenant-qualified ownership; pool access requires live service authorization. Runtime validation requires profile presence exactly in profiled mode, matching observation ordinals, and unavailable authority instead of invented zero facts. Validate final serialized bytes after adding observations; producers use UTC whole seconds."
    },
    "OrderedCapabilitiesV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "installation_id",
        "instance_id",
        "capability_revision",
        "authority_revision",
        "attempt_limit",
        "revision_bound_dispatch",
        "strict_receipts",
        "dispatch_enabled"
      ],
      "properties": {
        "contract_version": {
          "type": "integer",
          "const": 2
        },
        "installation_id": {
          "$ref": "#/$defs/Id"
        },
        "instance_id": {
          "$ref": "#/$defs/Id"
        },
        "capability_revision": {
          "$ref": "#/$defs/Id"
        },
        "authority_revision": {
          "$ref": "#/$defs/AuthorityRevision"
        },
        "attempt_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "revision_bound_dispatch": {
          "type": "boolean"
        },
        "strict_receipts": {
          "type": "boolean"
        },
        "dispatch_enabled": {
          "type": "boolean"
        }
      }
    },
    "OrderedDispatchBindingV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Bitrouter-Tenancy-Version",
        "Bitrouter-Installation-Id",
        "Bitrouter-Instance-Id",
        "Bitrouter-Capability-Revision",
        "Bitrouter-Execution-Revision",
        "Bitrouter-Correlation-Id",
        "Bitrouter-Receipt-Mode",
        "selection"
      ],
      "properties": {
        "Bitrouter-Tenancy-Version": {
          "type": "string",
          "const": "2"
        },
        "Bitrouter-Installation-Id": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Instance-Id": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Capability-Revision": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Execution-Revision": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Correlation-Id": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Receipt-Mode": {
          "type": "string",
          "const": "strict"
        },
        "selection": {
          "$ref": "#/$defs/OrderedCandidateSelectionV1"
        }
      }
    },
    "AttemptV2": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "native_usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NumericUsage"
          },
          "maxItems": 32
        },
        "candidate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "observed_http_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempt_id",
        "target",
        "outcome",
        "usage",
        "native_usage",
        "candidate_index",
        "observed_http_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/Target"
              },
              "observed_http_status": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 299
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ExecutionReceiptV2": {
      "type": "object",
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/Id"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "correlation_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_revision": {
          "$ref": "#/$defs/Id"
        },
        "state": {
          "enum": [
            "committed",
            "incomplete",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttemptV2"
          },
          "maxItems": 64
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "recorded_at": {
          "$ref": "#/$defs/Time"
        },
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "accepted_selection": {
          "$ref": "#/$defs/AcceptedSelectionV2"
        },
        "attempt_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "installation_id",
        "tenant_id",
        "principal_id",
        "execution_id",
        "correlation_id",
        "execution_revision",
        "state",
        "outcome",
        "attempts",
        "usage",
        "recorded_at",
        "schema_version",
        "accepted_selection",
        "attempt_limit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "attempts": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "outcome": {
                      "const": "completed"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attempts": {
                "contains": {
                  "properties": {
                    "outcome": {
                      "type": "string",
                      "const": "unknown"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "type": "string",
                "const": "unknown"
              },
              "outcome": {
                "type": "string",
                "const": "unknown"
              }
            }
          }
        }
      ],
      "$comment": "Maximum encoded size 1 MiB. Runtime validation enforces accepted count <= attempt_limit, actual attempts as a unique selected subsequence, no attempt after unknown/cancelled/completed, tenant ownership and conservative aggregate usage. Missing usage alone may leave a completed receipt incomplete."
    },
    "AttemptEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "target",
        "outcome",
        "terminal_observed"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "terminal_observed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_observed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "completed",
                  "failed"
                ]
              }
            }
          }
        }
      ]
    },
    "Frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "attempt_id",
        "protocol",
        "source",
        "semantics",
        "quantities",
        "unsupported",
        "invalid"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "protocol": {
          "$ref": "#/$defs/GenerationProtocol"
        },
        "source": {
          "enum": [
            "json",
            "http_error",
            "chat_chunk",
            "response_terminal",
            "message_start",
            "message_delta",
            "generate_content_chunk"
          ]
        },
        "semantics": {
          "type": "string",
          "const": "snapshot"
        },
        "quantities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "value"
            ],
            "properties": {
              "dimension": {
                "enum": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens",
                  "cache_read_tokens",
                  "cache_write_tokens",
                  "reasoning_tokens",
                  "web_search_requests",
                  "input_audio_tokens",
                  "output_audio_tokens",
                  "input_image_tokens",
                  "output_image_tokens",
                  "cache_write_five_minute_tokens",
                  "cache_write_one_hour_tokens"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "unsupported": {
          "type": "boolean"
        },
        "invalid": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "invalid": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "quantities": {
                "items": {
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "chat_completions"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "enum": [
                  "json",
                  "http_error",
                  "chat_chunk"
                ]
              },
              "semantics": {
                "const": "snapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "responses"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "enum": [
                  "json",
                  "http_error",
                  "response_terminal"
                ]
              },
              "semantics": {
                "const": "snapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "messages"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "enum": [
                  "json",
                  "http_error",
                  "message_start",
                  "message_delta"
                ]
              },
              "semantics": {
                "const": "snapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "generate_content"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "enum": [
                  "json",
