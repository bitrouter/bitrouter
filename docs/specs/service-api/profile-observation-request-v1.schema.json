{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdmissionProfileObservationRequestV1",
  "description": "One operator-only query, bound to a previously observed authority revision.",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Query version, exactly one.",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1
    },
    "expected_authority_revision": {
      "description": "Reject the whole query if actual authority differs.",
      "$ref": "#/$defs/AuthorityRevision"
    },
    "profiles": {
      "description": "Distinct full operator-pool Policy references, in desired response order.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "owner_kind": {
            "enum": [
              "tenant",
              "operator_pool"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "resource_kind": {
            "enum": [
              "route",
              "policy",
              "credential",
              "checkpoint",
              "configuration",
              "execution"
            ]
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "required": [
          "owner_kind",
          "owner_id",
          "resource_kind",
          "resource_id",
          "revision_id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "properties": {
              "owner_kind": {
                "const": "operator_pool"
              },
              "resource_kind": {
                "const": "policy"
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_authority_revision",
    "profiles"
  ],
  "$defs": {
    "AuthorityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
