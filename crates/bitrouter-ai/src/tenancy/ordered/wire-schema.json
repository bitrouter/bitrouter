{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordered dispatch contracts",
  "description": "Revision-bound ordered selection and discovery. Execution receipts and usage evidence use their shared dispatch-discriminated contracts.",
  "$comment": "Wire objects reject duplicate fields during decoding; JSON Schema validates parsed values. Encoded document/header limits and cross-document invariants are enforced at runtime.",
  "oneOf": [
    {
      "$ref": "#/$defs/OrderedCandidateSelection"
    },
    {
      "$ref": "#/$defs/CandidateManifest"
    },
    {
      "$ref": "#/$defs/OrderedCapabilities"
    },
    {
      "$ref": "#/$defs/OrderedDispatchBinding"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "AuthorityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Target": {
      "type": "object",
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/Id"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "account_id": {
          "$ref": "#/$defs/Id"
        },
        "credential_id": {
          "$ref": "#/$defs/Id"
        },
        "credential_version": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "provider_id",
        "model_id",
        "account_id",
        "credential_id",
        "credential_version"
      ],
      "additionalProperties": false
    },
    "RouteRef": {
      "type": "object",
      "properties": {
        "owner_kind": {
          "enum": [
            "tenant",
            "operator_pool"
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_kind": {
          "type": "string",
          "const": "route"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "owner_kind",
        "owner_id",
        "resource_kind",
        "resource_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "CredentialRef": {
      "type": "object",
      "properties": {
        "owner_kind": {
          "enum": [
            "tenant",
            "operator_pool"
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_kind": {
          "type": "string",
          "const": "credential"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "owner_kind",
        "owner_id",
        "resource_kind",
        "resource_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "GenerationProtocol": {
      "type": "string",
      "enum": [
        "chat_completions",
        "messages",
        "responses",
        "generate_content"
      ]
    },
    "CandidateIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "OrderedCandidateSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "route",
        "candidate_indices",
        "admission_mode"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "route": {
          "$ref": "#/$defs/RouteRef"
        },
        "candidate_indices": {
          "$ref": "#/$defs/CandidateIndices"
        },
        "admission_mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "generation_defaults_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AcceptedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "inbound_protocol",
        "candidate_indices",
        "admission_mode"
      ],
      "properties": {
        "route": {
          "$ref": "#/$defs/RouteRef"
        },
        "inbound_protocol": {
          "$ref": "#/$defs/GenerationProtocol"
        },
        "candidate_indices": {
          "$ref": "#/$defs/CandidateIndices"
        },
        "admission_mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "generation_defaults_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CandidateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_index",
        "target",
        "credential",
        "admission_profile"
      ],
      "properties": {
        "candidate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "credential": {
          "$ref": "#/$defs/CredentialRef"
        },
        "admission_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdmissionProfileRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CandidateManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "installation_id",
        "tenant_id",
        "execution_revision",
        "authority_revision",
        "route",
        "inbound_protocol",
        "candidates",
        "admission_mode",
        "runtime_observation"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "installation_id": {
          "$ref": "#/$defs/Id"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_revision": {
          "$ref": "#/$defs/Id"
        },
        "authority_revision": {
          "$ref": "#/$defs/AuthorityRevision"
        },
        "route": {
          "$ref": "#/$defs/RouteRef"
        },
        "inbound_protocol": {
          "$ref": "#/$defs/GenerationProtocol"
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CandidateDescriptor"
          }
        },
        "admission_mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "runtime_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeObservationV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$comment": "Maximum encoded size 1 MiB. Runtime validation enforces strictly increasing root ordinals, matching credential revisions and tenant-qualified ownership; pool access requires live service authorization. Runtime validation requires profile presence exactly in profiled mode, matching observation ordinals, and unavailable authority instead of invented zero facts. Validate final serialized bytes after adding observations; producers use UTC whole seconds."
    },
    "OrderedCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "installation_id",
        "instance_id",
        "capability_revision",
        "authority_revision",
        "attempt_limit",
        "revision_bound_dispatch",
        "strict_receipts",
        "dispatch_enabled"
      ],
      "properties": {
        "contract_version": {
          "type": "integer",
          "const": 2
        },
        "installation_id": {
          "$ref": "#/$defs/Id"
        },
        "instance_id": {
          "$ref": "#/$defs/Id"
        },
        "capability_revision": {
          "$ref": "#/$defs/Id"
        },
        "authority_revision": {
          "$ref": "#/$defs/AuthorityRevision"
        },
        "attempt_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "revision_bound_dispatch": {
          "type": "boolean"
        },
        "strict_receipts": {
          "type": "boolean"
        },
        "dispatch_enabled": {
          "type": "boolean"
        }
      }
    },
    "OrderedDispatchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Bitrouter-Tenancy-Version",
        "Bitrouter-Installation-Id",
        "Bitrouter-Instance-Id",
        "Bitrouter-Capability-Revision",
        "Bitrouter-Execution-Revision",
        "Bitrouter-Correlation-Id",
        "Bitrouter-Receipt-Mode",
        "selection"
      ],
      "properties": {
        "Bitrouter-Tenancy-Version": {
          "type": "string",
          "const": "2"
        },
        "Bitrouter-Installation-Id": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Instance-Id": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Capability-Revision": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Execution-Revision": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Correlation-Id": {
          "$ref": "#/$defs/Id"
        },
        "Bitrouter-Receipt-Mode": {
          "type": "string",
          "const": "strict"
        },
        "selection": {
          "$ref": "#/$defs/OrderedCandidateSelection"
        }
      }
    },
    "AdmissionMode": {
      "type": "string",
      "enum": [
        "unprofiled",
        "profiled"
      ]
    },
    "AdmissionProfileRef": {
      "type": "object",
      "properties": {
        "owner_kind": {
          "type": "string",
          "const": "operator_pool"
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_kind": {
          "type": "string",
          "const": "policy"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "owner_kind",
        "owner_id",
        "resource_kind",
        "resource_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "RateObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_rpm",
        "shared_count"
      ],
      "properties": {
        "member_rpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "shared_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "CandidateObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_index",
        "current_profile_revision",
        "rate",
        "health",
        "availability"
      ],
      "properties": {
        "candidate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "current_profile_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateObservationV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "type": "string",
          "enum": [
            "disabled",
            "healthy",
            "blocked",
            "probe_ready",
            "unavailable"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "eligible",
            "rate_limited",
            "circuit_blocked",
            "authority_denied",
            "capacity_denied"
          ]
        },
        "observed_shared_count": {
          "description": "Count from an explicit read-only same-owner rate group; absence is unavailable or unconfigured.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "RuntimeObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "observed_at",
        "candidates"
      ],
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/Id"
        },
        "observed_at": {
          "$ref": "#/$defs/Time"
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CandidateObservationV1"
          }
        }
      }
    }
  }
}
