{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderTechnicalFactsV2",
  "description": "Optional original Core-owned pipeline/hop observations and unchanged operations. One combined UTF-8 encoded object <=65536 bytes. No financial/admission authority; validate against original receipt and child edges. No old-hop equivalence is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_format",
    "installation_id",
    "tenant_id",
    "principal_id",
    "execution_id",
    "execution_revision",
    "operations",
    "pipeline_scope",
    "hop_observations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "receipt_format": {
      "enum": [
        1,
        2
      ]
    },
    "installation_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tenant_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "principal_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "execution_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "execution_revision": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_ids",
          "selected_attempt_id",
          "streamed",
          "upstream_duration_ms",
          "first_semantic",
          "generation_duration_ms",
          "partial"
        ],
        "properties": {
          "attempt_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "selected_attempt_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "streamed": {
            "type": "boolean"
          },
          "upstream_duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              {
                "type": "null"
              }
            ]
          },
          "first_semantic": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ttft_ms",
                  "kind"
                ],
                "properties": {
                  "ttft_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "kind": {
                    "enum": [
                      "reasoning",
                      "text",
                      "tool"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "generation_duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              {
                "type": "null"
              }
            ]
          },
          "partial": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "streamed": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "first_semantic": {
                  "type": "null"
                },
                "generation_duration_ms": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "first_semantic": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "generation_duration_ms": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "generation_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "partial": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "upstream_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              }
            }
          }
        ]
      }
    },
    "pipeline_scope": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "context_request_id",
            "request_duration_ms",
            "streamed",
            "stream"
          ],
          "properties": {
            "profile": {
              "const": "core_pipeline_finalized_v1"
            },
            "context_request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "request_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "streamed": {
              "type": "boolean"
            },
            "stream": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profile",
                    "source_attempt_id",
                    "terminal_attempt_id",
                    "upstream_duration_ms",
                    "first_semantic",
                    "generation_duration_ms",
                    "partial"
                  ],
                  "properties": {
                    "profile": {
                      "const": "core_pipeline_merged_stream_v1"
                    },
                    "source_attempt_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "terminal_attempt_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "upstream_duration_ms": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "first_semantic": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "ttft_ms",
                            "kind"
                          ],
                          "properties": {
                            "ttft_ms": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 18446744073709551615
                            },
                            "kind": {
                              "enum": [
                                "reasoning",
                                "text",
                                "tool"
                              ]
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "generation_duration_ms": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "partial": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "hop_observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "attempt_ids",
          "closing_attempt_id",
          "duration_ms",
          "end",
          "partial"
        ],
        "properties": {
          "profile": {
            "enum": [
              "core_json_hop_callbacks_v1",
              "core_stream_open_callbacks_v1",
              "core_stream_hop_notify_v1"
            ]
          },
          "attempt_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "closing_attempt_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "enum": [
              "unobserved",
              "completed",
              "failed",
              "dropped"
            ]
          },
          "partial": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_format": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "maxItems": 8,
            "items": {
              "properties": {
                "attempt_ids": {
                  "maxItems": 8
                }
              }
            }
          }
        }
      }
    }
  ]
}
