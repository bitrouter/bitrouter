    {
      "name": "native-features",
      "args": [
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features"
      ]
    },
    {
      "name": "acp-features",
      "args": [
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features",
        "--features",
        "acp"
      ]
    },
    {
      "name": "native-tree",
      "args": [
        "tree",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features",
        "-e",
        "normal,build",
        "--prefix",
        "none"
      ]
    },
    {
      "name": "msrv-native",
      "args": [
        "+1.93",
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features"
      ]
    },
    {
      "name": "acp-recovery",
      "args": [
