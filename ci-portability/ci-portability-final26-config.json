{
  "id": "ci-portability-final26",
  "scope": "Correct exact-head CI failures from 25cbd553: keep protocol wire material independent of optional ACP runtime; preserve original permission IDs and deny unoffered option; use MSRV-compatible CAS in concurrent budget test instead of newly deprecated fetch_update. Full post-fix regression, zero-LEAK qualification and source-drift audit. Prior CI and local final15 results retain their original source binding; no fixture/runtime limit changes.",
  "jobs": [
    {
      "name": "native-features",
      "args": [
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features"
      ]
    },
    {
      "name": "acp-features",
      "args": [
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features",
        "--features",
        "acp"
      ]
    },
    {
      "name": "native-tree",
      "args": [
        "tree",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features",
        "-e",
        "normal,build",
        "--prefix",
        "none"
      ]
    },
    {
      "name": "msrv-native",
      "args": [
        "+1.93",
        "check",
        "--locked",
        "-p",
        "bitrouter-orchestrator",
        "--no-default-features"
      ]
    },
    {
      "name": "acp-recovery",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--lib",
        "-E",
        "test(acp_pre_prompt_recovery_loads_only_the_original_stopped_session) | test(service::tests::worker::)"
      ]
    },
    {
      "name": "typed-startup",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--lib",
        "-E",
        "test(goal_runtime::resources::tests::unsupported_mcp_transports_) | test(goal_runtime::resources::tests::unconfirmed_model_route_)"
      ]
    },
    {
      "name": "workspace",
      "args": [
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--no-fail-fast"
      ]
    },
    {
      "name": "clippy",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "fmt",
      "args": [
        "fmt",
        "--",
        "--check"
      ]
    },
    {
      "name": "doctest",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--doc"
      ]
    },
    {
      "name": "registry",
      "args": [
        "run",
        "-p",
        "dist-helper",
        "--",
        "check"
      ]
    }
  ]
}
